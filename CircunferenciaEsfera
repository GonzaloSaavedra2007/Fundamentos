#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float cicunferencia, area, volumen, diametro, radio;
    cout<<"Ingresa el diametro de la esfera: ";
    cin>> diametro;
    radio=diametro/2.0;
    circunferencia= 3.14159*diametro;
    area=3.14159*diametro*diametro;
    volumen=(4.0/3.0)*3.14159*radio*radio*radio;
    cout<<"circunferencia: "<<circunferencia<<endl;
    cout<<"area: "<<area<<endl<<;
    cout<<"volumen: "<<volumen<<endl;
}
