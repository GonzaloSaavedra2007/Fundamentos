#include <iostream>

using namespace std;

//Prototipos
float cubo(float n);
int calcularmenor(int a, int b);;
int signo(float a);

int main()
{
	float b, a, d, f;
	int opcion, x;
	//Menu
	do {
		//Desplegar las opciones
		cout << "\t\t Menu \n";
		cout << "\t\t ==== \n";
		cout << "1. Calcular el cubo \n";
		cout << "2. El menor de dos numeros enteros \n";
		cout << "3. El signo de un numero \n";
		cout << "0. Salir\n";
		cout << "Opcion: ";
		cin >> opcion;
		//Condicional multiple
		switch (opcion)
		{
		case 1:
			cout << "Ingresa un numero: ";
			cin >> b;
			a = cubo(b);
			cout << "El resultado es: " << a;
			break;
		case 2:
			cout << "Ingresa el primer numero: ";
			cin >> a;
			cout << "Ingresa el segundo numero: ";
			cin >> b;
			d = calcularmenor(a, b);
			cout << "El menor es: " << d;
			break;
		case 3:
			cout << "Ingresa un numero: ";
			cin >> f;
			x = signo(f);
			cout << "El resultado es: " << x;
			break;
		case 0: cout << "Error de opcion: ";
			break;
		default: cout << "Error de opcion: ";
			break;
		}
		system("cls");
	} while (opcion != 0);
}


//Declarar o definir funciones
float cubo(float n) {
	return n * n * n;
}
int calcularmenor(int a, int b) {
	if (a < b) {
		return a;
	}
	else {
		return b;
	}
}
int signo(float a) {
	if (a > 0) {
		return 1;
	}
	else if (a < 0) {
		return 1;
	}
	else if (a < 0) {
		return -1;
	}
	else {
		return 0;
	}
}
